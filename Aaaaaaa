    end
end)

local function GetTarget()
    if Settings.CurrentTarget and Settings.CurrentTarget:FindFirstChild("Humanoid") and Settings.CurrentTarget.Humanoid.Health > 0 then
        local root = Settings.CurrentTarget:FindFirstChild(Settings.LockPart)
        if root then
            local _, onScreen = camera:WorldToViewportPoint(root.Position)
            if onScreen and (not Settings.WallCheck or IsVisible(root)) then
                return Settings.CurrentTarget
            end
        end
    end
    
    Settings.CurrentTarget = nil
    local target = nil
    local dist = math.huge
    local mouse = UIS:GetMouseLocation()
    
    for _, v in pairs(Players:GetPlayers()) do
        if v ~= LP and v.Character and v.Character:FindFirstChild(Settings.LockPart) then
            if Settings.TeamCheck and v.Team == LP.Team then continue end
            local hum = v.Character:FindFirstChild("Humanoid")
            if hum and hum.Health > 0 then
                local part = v.Character[Settings.LockPart]
                local pos, onScreen = camera:WorldToViewportPoint(part.Position)
                local visible = Settings.WallCheck and IsVisible(part) or not Settings.WallCheck
                
                if onScreen and visible then
                    local mDist = (Vector2.new(pos.X, pos.Y) - mouse).Magnitude
                    if mDist < dist and mDist < aimRadius then
                        dist = mDist
                        target = v.Character
                    end
                end
            end
        end
    end
    Settings.CurrentTarget = target
    return target
end

RunService.RenderStepped:Connect(function(deltaTime)
    fovCircle.Position = UIS:GetMouseLocation()
    
    if (Settings.Aimbot or Settings.Camlock) then
        local t = GetTarget()
        if t then
            local targetPos = t[Settings.LockPart].Position
            local lookAt = CFrame.new(camera.CFrame.Position, targetPos)
            local alpha = math.clamp(1 - math.pow(1 - Settings.Smoothness, deltaTime * 60), 0, 1)
            camera.CFrame = camera.CFrame:Lerp(lookAt, alpha)
        end
    end
end)

