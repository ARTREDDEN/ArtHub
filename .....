--// ESP System
local espCache = {}
local function CreateESP(v)
    if espCache[v] then return end
    local espData = { Box = Drawing.new("Square"), Name = Drawing.new("Text"), Tracer = Drawing.new("Line") }
    espData.Box.Visible = false; espData.Box.Thickness = 1.5; espData.Box.Color = Color3.fromRGB(0, 255, 255); espData.Box.Filled = false
    espData.Name.Visible = false; espData.Name.Size = 14; espData.Name.Color = Color3.fromRGB(255, 255, 255); espData.Name.Center = true; espData.Name.Outline = true
    espData.Tracer.Visible = false; espData.Tracer.Thickness = 1; espData.Tracer.Color = Color3.fromRGB(0, 255, 255)
    espCache[v] = espData
end

local function RemoveESP(v)
    if espCache[v] then
        for _, obj in pairs(espCache[v]) do obj:Remove() end
        espCache[v] = nil
    end
end

Players.PlayerRemoving:Connect(RemoveESP)

RunService.RenderStepped:Connect(function()
    for _, v in pairs(Players:GetPlayers()) do
        if v ~= LP and v.Character and v.Character:FindFirstChild("HumanoidRootPart") and v.Character:FindFirstChild("Humanoid") then
            if v.Character.Humanoid.Health > 0 then
                if not espCache[v] then CreateESP(v) end
                local data = espCache[v]
                local hrp = v.Character.HumanoidRootPart
                local highlight = v.Character:FindFirstChild("ArtHubChams") or Instance.new("Highlight", v.Character)
                highlight.Name = "ArtHubChams"
                highlight.Enabled = Settings.ESP_Chams
                highlight.FillColor = Color3.fromRGB(255, 0, 0)
                highlight.OutlineColor = Color3.fromRGB(255, 255, 255)

                local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                if onScreen then
                    local sizeX = 2000 / pos.Z
                    local sizeY = 3000 / pos.Z
                    data.Box.Visible = Settings.ESP_Box
                    if Settings.ESP_Box then
                        data.Box.Size = Vector2.new(sizeX, sizeY)
                        data.Box.Position = Vector2.new(pos.X - sizeX / 2, pos.Y - sizeY / 2)
                    end
                    data.Name.Visible = Settings.ESP_Name
                    if Settings.ESP_Name then
                        data.Name.Text = v.Name
                        data.Name.Position = Vector2.new(pos.X, pos.Y - sizeY / 2 - 18)
                    end
                    data.Tracer.Visible = Settings.ESP_Tracers
                    if Settings.ESP_Tracers then
                        data.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                        data.Tracer.To = Vector2.new(pos.X, pos.Y + sizeY / 2)
                    end
                else
                    data.Box.Visible = false; data.Name.Visible = false; data.Tracer.Visible = false
                end
            else RemoveESP(v) end
        else RemoveESP(v) end
    end
end)

