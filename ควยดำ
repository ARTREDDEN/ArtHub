-- =================================================================
-- [[ SOUND EFFECT SYSTEM ]] --
-- =================================================================
local SoundId = "rbxassetid://17566020304"

local function PlayToggleSound()
    pcall(function()
        local sound = Instance.new("Sound")
        sound.SoundId = SoundId
        sound.Volume = 1
        sound.Parent = game:GetService("SoundService")
        sound:Play()
        sound.Ended:Connect(function()
            sound:Destroy()
        end)
    end)
end

